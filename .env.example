# ── Provider 1 (primary): aiograpi-rest (github.com/subzeroid/instagrapi) ──
# Where your aiograpi-rest service is running, e.g. https://your-host.onrender.com
# INSTAGRAPI_URL=
#
# Auth — either a sessionid cookie (recommended):
#   instagram.com → DevTools → Application → Cookies → sessionid
# INSTAGRAPI_SESSION_ID=
#
# …or username/password (the provider logs in once and caches the session):
# INSTAGRAPI_USERNAME=
# INSTAGRAPI_PASSWORD=

# ── Provider 2: generic key-less REST provider (insta-reel-api style) ──
# Template with {url} placeholder, e.g. https://host/?url={url}
# INSTAGRAM_API_URL=
# Optional API key sent as X-API-Key
# INSTAGRAM_API_KEY=

# ── Provider 3: RapidAPI ──
# RAPIDAPI_URL=
# RAPIDAPI_KEY=
# RAPIDAPI_HOST=
